              }
            }
          ],
          "message": {
            "text": "Upstream compromise is automatically converted into a signed release\n\nPin automation hashes the same AppImages delivered by upstream, auto-approves those digests, and later signs the package without an independent authenticity signal.\n\nSeverity: medium\n\nCategory: Artifact authenticity\n\nWeaknesses: CWE-345\n\nRemediation:\nRequire vendor signatures or independently authenticated provenance; otherwise require an independent human release decision and validate final redirect origins.\n\nRemediation tests:\n- Reject candidates without independently verified authenticity.\n- Prevent pin automation from providing final release approval.\n\nPreventive controls:\n- Bind provenance to version, commit, architecture, URL, and digest."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:d09d0899e7a877cb4ceae7e89d514494fbbad38f18f75165741f7d1736c3f77e"
          },
          "properties": {
            "category": "artifact-authenticity",
            "confidence": "high",
            "findingId": "csf_47b6efedb3af8a422a230b4d",
            "occurrenceId": "occ_7203b3d3b8da11d87376d2dd",
            "severity": "medium"
          },
          "ruleId": "artifact-authenticity.self-derived-upstream-checksum",
          "ruleIndex": 1
        },

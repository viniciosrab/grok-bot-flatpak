            "confidence": "high",
            "findingId": "csf_d91ece76c67571e4c8f4a124",
            "occurrenceId": "occ_cdf92c80bf07a26dd24f6524",
            "severity": "low"
          },
          "ruleId": "artifact-authenticity.flatpak-gpg-verification-disabled",
          "ruleIndex": 0
        }
      ],

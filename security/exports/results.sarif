            "findingId": "csf_20459427e20e91f6c8db2639",
            "occurrenceId": "occ_40bbfeb11a4c47ca5f10c5c7",
            "severity": "medium"
          },
          "ruleId": "release-authorization.main-version-bump",
          "ruleIndex": 3
        },
